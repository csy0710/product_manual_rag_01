# ============================================================================
# 复制本文件为 .env 后填写真实配置：cp .env.example .env
# .env 已被 .gitignore 屏蔽，请勿把真实密钥提交到仓库
# ============================================================================

# ===================== 大模型（阿里云百炼 DashScope，OpenAI 兼容模式） =====================
# api_key 申请地址：https://bailian.console.aliyun.com/  →  API-KEY 管理
# 同一个 Key 同时用于：对话模型、视觉模型、WebSearch MCP
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 问答/主体识别用的对话模型
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1
# 图片理解用的多模态模型
VL_MODEL=qwen3-vl-flash
# MCP 服务用的 Key（当前与 OPENAI_API_KEY 相同）
BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 百炼 WebSearch MCP 的 Streamable HTTP 地址（固定值，无需修改）
MCP_DASHSCOPE_BASE_URL_STREAMABLE=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ===================== 文档解析（MinerU 云端 API，PDF → Markdown） =====================
# Token 申请地址：https://mineru.net/
MINERU_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINERU_BASE_URL=https://mineru.net/api/v4
# 中间产物（md、图片）落盘目录
MD_ROOT_DIR=./temp-files/

# ===================== 向量化模型（本地 BGE-M3，稠密 + 稀疏混合向量） =====================
# 本地模型权重路径；留空则回退到从 ModelScope/HuggingFace 下载 "BAAI/bge-m3"
BGE_M3_PATH=/path/to/models/BAAI/bge-m3
# 模型仓库标识，BGE_M3_PATH 为空时使用
BGE_M3=BAAI/bge-m3
# 运行设备：cuda:0 / cpu
BGE_DEVICE=cpu
# 半精度：GPU 用 1，CPU 必须用 0
BGE_FP16=0
# 打印主体识别的中间过程日志（1 开启 / 0 关闭）
ITEM_NAME_DIAG=1

# ===================== 重排序模型（本地 bge-reranker-large） =====================
BGE_RERANKER_LARGE=/path/to/models/rerank/BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=1

# 模型下载缓存目录（仅在需要联网下载权重时生效）
MODELSCOPE_CACHE=/path/to/modelscope_cache
HF_HOME=/path/to/huggingface_cache
# 开发环境可设为 1 强制离线读取本地缓存
MODELSCOPE_OFFLINE=0

# ===================== Milvus 向量数据库 =====================
MILVUS_URL=http://127.0.0.1:19530
# 切片集合（稠密 + 稀疏混合检索）
CHUNKS_COLLECTION=kb_chunks
# 预留：图实体名称集合
ENTITY_NAME_COLLECTION=kb_graph_entity_names
# 主体名称集合（每个文档对应一个主体，用于问题的主体确认）
ITEM_NAME_COLLECTION=kb_item_names
# 预留项：当前代码尚未读取，保留以便后续切换相似度度量与召回阈值
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# ===================== MongoDB（多轮对话历史） =====================
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=kb002

# ===================== MinIO（对象存储：原始文件与图片） =====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ===================== Neo4j（可选，当前流程未启用） =====================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j

# ===================== 日志 =====================
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
# 日志文件保留天数
LOG_FILE_RETENTION=7 days
